+# A KMZ is a compressed archive, so the 50 MB upload limit says nothing about
+# how much KML it expands into.  Refuse anything that unpacks beyond this.
+MAX_KML_BYTES = 8 * 1024 * 1024
+
+
 def parse_kmz_file(kmz_path):
     """Extract doc.kml from a KMZ file and parse it."""
     with zipfile.ZipFile(kmz_path, 'r') as zf:
         kml_files = [f for f in zf.namelist() if f.endswith('.kml')]
         if not kml_files:
             return []
+        expanded = zf.getinfo(kml_files[0]).file_size
+        if expanded > MAX_KML_BYTES:
+            raise ValueError(
+                f'KMZ expands to {expanded} bytes, over the {MAX_KML_BYTES} byte limit'
+            )
         kml_data = zf.read(kml_files[0]).decode('utf-8')
     return parse_kml_content(kml_data)
 
