# Copy to .env (docker compose reads it automatically) and adjust.
# .env is git-ignored; never commit real secrets.

# --- sessions -----------------------------------------------------------------
# REQUIRED in a multi-worker deployment: every gunicorn worker must sign with
# the same key, otherwise users are logged out at random.
SECRET_KEY=change-me-to-a-long-random-string

# --- published ports ----------------------------------------------------------
WEB_PORT=8000
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# --- broker credentials -------------------------------------------------------
RABBITMQ_DEFAULT_USER=fis
RABBITMQ_DEFAULT_PASS=fis

# --- runtime tuning -----------------------------------------------------------
# Set to 1 when serving over HTTPS so the session cookie is HTTPS-only.
SESSION_COOKIE_SECURE=0
WEB_CONCURRENCY=4
GUNICORN_THREADS=4
MONGO_MAX_POOL_SIZE=50
STATIC_CACHE_SECONDS=3600
LOG_LEVEL=INFO

# --- database ------------------------------------------------------------------
# Empty: use the `mongo` container defined in docker-compose.yml.  Set it to an
# external cluster to use that instead; keep the password URL-encoded (`@` -> `%40`).
# MONGO_URI=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/FIS?retryWrites=true&w=majority&appName=Cluster0
MONGO_URI=

# --- domain events ------------------------------------------------------------
# 1 = publish to RabbitMQ (default), 0 = run as a standalone monolith.
EVENTS_ENABLED=1
EVENTS_EXCHANGE=fis.events
EVENTS_AUDIT_QUEUE=fis.audit

# --- optional integrations (leave empty to log instead of send) ---------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
BLUETICKS_API_KEY=
