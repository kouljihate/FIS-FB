# ---------------------------------------------------------------------------
# Irrigation Planning System (FIS) - FreeBuff build
# Copy this file to `.env` and adjust.  Never commit the real `.env`.
# ---------------------------------------------------------------------------

# Flask
SECRET_KEY=change-me-to-a-long-random-string
FLASK_DEBUG=1
FLASK_RUN_HOST=127.0.0.1
FLASK_RUN_PORT=5000

# MongoDB - the FreeBuff build uses its OWN database name so it can never
# collide with the data used by the other copies of this app.
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DBNAME=fis_freebuff
MONGO_TIMEOUT_MS=3000

# Engineering defaults (SI unless noted)
DEFAULT_SECTOR_AREA_HA=1.0
DEFAULT_ZONES_PER_SECTOR=3
DEFAULT_PIPE_DIAMETERS_MM=90,63,32
DEFAULT_DRIPPER_FLOW_LPH=2.0
DEFAULT_DRIPPER_SPACING_M=0.40
DEFAULT_LATERAL_SPACING_M=1.50

# i18n
DEFAULT_LANGUAGE=en
